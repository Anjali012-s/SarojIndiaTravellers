  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm install",
  "buildCommand": "npx ng build --configuration production",
  "outputDirectory": "dist/saroj-india-travellers/browser",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
